# Bind locally by default.
A2A_MCP_HOST=127.0.0.1
A2A_MCP_PORT=8931

# Optional when the A2A Agent Card must advertise a routable address.
# A2A_MCP_PUBLIC_BASE_URL=https://bridge.example.com

# Optional MCP endpoint authentication.
# A2A_MCP_BEARER_TOKEN=replace-me

# Outbound A2A agents. Values can also be plain Agent Card URL strings.
A2A_MCP_AGENTS={}

# Inbound A2A caller identity is derived from the matching bearer token.
A2A_MCP_INBOUND_PEER_TOKENS={}

# Persistent tasks and ChatGPT MCP Events subscriptions.
# A2A_MCP_DATA_DIR=/var/lib/a2a-mcp

# Maximum subscription lifetime in milliseconds.
# A2A_MCP_SUBSCRIPTION_TTL_MS=604800000
